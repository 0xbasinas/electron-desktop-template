{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "electron-desktop-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  // Better Auth uses AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The Worker serves the built web app and the API from one origin, so the sign-in cookie is
  // first-party and there is no CORS. Only /api/* runs Worker code; static files are free and unmetered.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "electron-desktop-template",
      // Replace with the id printed by `wrangler d1 create electron-desktop-template`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  "vars": {
    // The public address of the site (and of the API: same origin). Change it to your domain.
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Origins besides the site that may call the API. The desktop app sends its deep-link scheme as its origin.
    "TRUSTED_ORIGINS": "electron-desktop-template:/",
    // Sender address. The domain must be verified in Resend.
    "EMAIL_FROM": "Electron Desktop Template <login@example.com>"
  }
  // Secrets (set with `wrangler secret put`): BETTER_AUTH_SECRET, RESEND_API_KEY.
}
